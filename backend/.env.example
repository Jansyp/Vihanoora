MONGO_URL=mongodb://localhost:27017
DB_NAME=jave_house
JWT_SECRET=change-this-secret
CORS_ORIGINS=http://localhost:3000
STORAGE_MODE=local

# Read-only GA4 Data API reporting for the admin analytics dashboard.
GA4_PROPERTY_ID=556716338
# Used only if the Data API cannot provide property metadata; successful GA4 reports return the property's timezone.
GA4_PROPERTY_TIMEZONE=Asia/Kolkata
# Render Secret File: GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/viaura-ga4-reader.json
# Set locally to a securely mounted service-account JSON file. Never commit service-account credentials.

# Cashfree sandbox credentials (server-side only; never expose the secret to React)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2026-01-01
CASHFREE_API_BASE=https://sandbox.cashfree.com/pg
# Storefront URL used to build the Cashfree return_url (NOT the API URL).
# Production (Render): FRONTEND_BASE_URL=https://www.vihaanora.com
FRONTEND_BASE_URL=http://localhost:3000
CASHFREE_WEBHOOK_URL=http://localhost:8000/api/payments/cashfree/webhook

# Customer-facing online payment switch (backend enforced)
PAYMENTS_ENABLED=false
